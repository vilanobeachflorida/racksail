{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vilanobeachflorida/racksail/main/spec/schemas/recipe.schema.json",
  "title": "Racksail recipe",
  "description": "A catalog item: an app, runtime, service, stack, DNS template, automation, tuning preset, model, theme or add-on, described as resources to create from the user's inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "kind", "id", "name", "version", "summary", "license", "licenseClass", "maintainers"],
  "properties": {
    "format": { "const": 1 },
    "kind": {
      "enum": ["app", "runtime", "service", "stack", "dns-template", "automation", "tuning-preset", "model", "theme", "addon"]
    },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "description": "Version of the software the recipe installs.", "type": "string", "minLength": 1 },
    "revision": { "description": "Revision of the recipe itself.", "type": "integer", "minimum": 1 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string" },
    "license": { "description": "SPDX license expression of the software.", "type": "string", "minLength": 1 },
    "licenseClass": {
      "description": "Anything that isn't open source is never installed by default and shows a notice first.",
      "enum": ["open-source", "free-to-use", "proprietary"]
    },
    "homepage": { "type": "string", "format": "uri" },
    "source": { "type": "string", "format": "uri" },
    "icon": { "type": "string" },
    "categories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string" }, "github": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" } }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" }
        },
        "memoryMB": { "type": "integer", "minimum": 0 },
        "diskMB": { "type": "integer", "minimum": 0 },
        "arch": { "type": "array", "uniqueItems": true, "items": { "enum": ["amd64", "arm64"] } },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["virtualization", "kvm", "iommu", "gpu"] }
        }
      }
    },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
    "downloads": { "type": "array", "items": { "$ref": "#/$defs/download" } },
    "health": { "type": "array", "items": { "$ref": "#/$defs/healthCheck" } },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "enum": ["in-place", "snapshot-then-replace", "manual"] },
        "notes": { "type": "string" }
      }
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keepData": { "description": "Data is kept unless the user chooses otherwise.", "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "tests": {
      "description": "Install test run in CI for official recipes.",
      "type": "object",
      "additionalProperties": false,
      "properties": { "inputs": { "type": "object" }, "timeoutSeconds": { "type": "integer", "minimum": 1 } }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "label"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "type": {
          "enum": ["string", "text", "integer", "boolean", "select", "domain", "email", "password", "secret", "resource"]
        },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "default": {},
        "required": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": { "value": { "type": "string" }, "label": { "type": "string" } }
          }
        },
        "kind": { "description": "For resource inputs, the kind to pick from.", "type": "string" },
        "pattern": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "resource": {
      "description": "A resource to create. String values may use ${inputs.<name>} and ${resources.<name>.id}.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "spec"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$" },
        "spec": { "type": "object" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url"],
          "properties": {
            "type": { "enum": ["gpg", "minisign", "sigstore"] },
            "url": { "type": "string", "format": "uri" },
            "key": { "type": "string" }
          }
        }
      }
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "enum": ["http", "tcp", "dns", "tls", "unit"] },
        "target": { "type": "string" },
        "expect": { "type": "string" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    }
  }
}
