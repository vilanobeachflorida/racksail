{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vilanobeachflorida/racksail/main/spec/schemas/recipe.schema.json",
  "title": "Racksail recipe",
  "description": "A catalog item: an app, runtime, service, stack, DNS template, automation, tuning preset, model, theme or add-on, described as resources to create from the user's inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "kind", "id", "name", "version", "summary", "license", "licenseClass", "maintainers"],
  "properties": {
    "format": { "const": 1 },
    "kind": {
      "enum": ["app", "runtime", "service", "stack", "dns-template", "automation", "tuning-preset", "model", "theme", "addon"]
    },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "description": "Version of the software the recipe installs.", "type": "string", "minLength": 1 },
    "revision": { "description": "Revision of the recipe itself.", "type": "integer", "minimum": 1 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string" },
    "license": { "description": "SPDX license expression of the software.", "type": "string", "minLength": 1 },
    "licenseClass": {
      "description": "Anything that isn't open source is never installed by default and shows a notice first.",
      "enum": ["open-source", "free-to-use", "proprietary"]
    },
    "homepage": { "type": "string", "format": "uri" },
    "source": { "type": "string", "format": "uri" },
    "icon": {
      "description": "An SVG or PNG file in the item's directory. URLs aren't allowed: catalogs bundle what they show.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*\\.(svg|png)$"
    },
    "categories": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string" }, "github": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" } }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" }
        },
        "memoryMB": { "type": "integer", "minimum": 0 },
        "diskMB": { "type": "integer", "minimum": 0 },
        "arch": { "type": "array", "uniqueItems": true, "items": { "enum": ["amd64", "arm64"] } },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["virtualization", "kvm", "iommu", "gpu"] }
        }
      }
    },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
    "downloads": { "type": "array", "items": { "$ref": "#/$defs/download" } },
    "health": {
      "description": "How a panel tells that what it installed works. Official recipes have at least one check.",
      "type": "array",
      "items": { "$ref": "#/$defs/healthCheck" }
    },
    "model": { "$ref": "#/$defs/model" },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "enum": ["in-place", "snapshot-then-replace", "manual"] },
        "notes": { "type": "string" }
      }
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keepData": { "description": "Data is kept unless the user chooses otherwise.", "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "tests": {
      "description": "Install test run in CI for official recipes: the item is installed with these inputs on a fresh server, and its health checks must pass within the timeout.",
      "type": "object",
      "additionalProperties": false,
      "properties": { "inputs": { "type": "object" }, "timeoutSeconds": { "type": "integer", "minimum": 1 } }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "label"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "type": {
          "enum": ["string", "text", "integer", "boolean", "select", "domain", "email", "password", "secret", "resource"]
        },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "default": {},
        "required": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": { "value": { "type": "string" }, "label": { "type": "string" } }
          }
        },
        "kind": { "description": "For resource inputs, the kind to pick from.", "type": "string" },
        "pattern": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "resource": {
      "description": "A resource to create. String values may use ${inputs.<name>} and ${resources.<name>.id}.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "spec"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9_]*$" },
        "spec": { "type": "object" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url"],
          "properties": {
            "type": { "enum": ["gpg", "minisign", "sigstore"] },
            "url": { "type": "string", "format": "uri" },
            "key": { "type": "string" }
          }
        }
      }
    },
    "healthCheck": {
      "description": "http, tcp, dns and tls checks probe an address and unit checks a systemd unit. A resource check passes once a resource the recipe creates, named by its name, or the installed item itself, named by the recipe's id, is ready: its module applied it and its own checks pass.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "enum": ["http", "tcp", "dns", "tls", "unit", "resource"] },
        "target": {
          "description": "A URL, host:port, DNS name or unit name, or for a resource check, the name of one of the recipe's resources or the recipe's id. It may use ${inputs.<name>}.",
          "type": "string",
          "minLength": 1
        },
        "expect": {
          "description": "The expected status code, address, certificate name or unit state. Resource checks expect the resource to be ready.",
          "type": "string"
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 }
      },
      "if": { "properties": { "type": { "const": "resource" } } },
      "then": { "properties": { "expect": false } }
    },
    "model": {
      "description": "What the model picker shows about an assistant model and how it chooses one for the server's memory.",
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "parameters", "format", "contextLength", "size"],
      "properties": {
        "family": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$" },
        "parameters": {
          "description": "Parameter count, such as 8B or 0.6B.",
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?[MB]$"
        },
        "quantization": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,32}$" },
        "format": { "description": "The file format llama.cpp loads.", "enum": ["gguf"] },
        "contextLength": { "type": "integer", "minimum": 512 },
        "size": { "description": "The size class the picker recommends by memory.", "enum": ["small", "medium", "large"] },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["chat", "tools", "code", "vision", "embedding"] }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "A model says what it is, which files to download and how much memory it needs.",
      "if": { "properties": { "kind": { "const": "model" } } },
      "then": {
        "required": ["model", "downloads", "requires"],
        "properties": {
          "downloads": { "minItems": 1 },
          "requires": { "required": ["memoryMB"] }
        }
      },
      "else": { "not": { "required": ["model"] } }
    },
    {
      "description": "Themes and add-ons are installed from their own package, theme.yaml or addon.yaml next to the recipe; everything else creates resources.",
      "if": { "properties": { "kind": { "enum": ["theme", "addon"] } } },
      "then": { "not": { "anyOf": [{ "required": ["resources"] }, { "required": ["inputs"] }] } },
      "else": { "required": ["resources"], "properties": { "resources": { "minItems": 1 } } }
    }
  ]
}
