          },
          "version": {
            "description": "The add-on's version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "apiVersion"
        ],
        "type": "object"
      },
      "ChangeSet": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/Actor"
          },
          "appliedAt": {
            "format": "date-time",
            "type": "string"
          },
          "changedSince": {
            "description": "For an undo, the resources that changed after the change set it undoes: undoing puts back their settings from before that change set all the same, so what changed since goes too",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/ResourceChange"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "conflicts": {
            "items": {
              "$ref": "#/components/schemas/Conflict"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "contributions": {
            "items": {
              "$ref": "#/components/schemas/Contribution"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "dryRun": {
            "type": "boolean"
          },
          "effects": {
            "items": {
              "$ref": "#/components/schemas/Effect"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "error": {
            "type": "string"
          },
          "estimate": {
            "$ref": "#/components/schemas/Estimate"
          },
          "id": {
            "type": "string"
          },
          "job": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "read",
