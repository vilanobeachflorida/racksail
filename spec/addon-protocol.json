            "type": "boolean"
          },
          "detail": {
            "description": "Extra detail such as a version",
            "type": "string"
          },
          "diskBytes": {
            "description": "Estimated disk use in bytes",
            "format": "int64",
            "type": "integer"
          },
          "downloadBytes": {
            "description": "Bytes downloaded",
            "format": "int64",
            "type": "integer"
          },
          "memoryBytes": {
            "description": "Estimated memory use in bytes",
            "format": "int64",
            "type": "integer"
          },
          "source": {
            "description": "Where a download comes from",
            "type": "string"
          },
          "target": {
