          "diskBytes": {
            "format": "int64",
            "type": "integer"
          },
          "downloadBytes": {
            "format": "int64",
            "type": "integer"
          },
          "memoryBytes": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
