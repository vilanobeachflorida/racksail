    "/ui/{path}": {
      "get": {
        "description": "Pages of the add-on's UI extensions that need more than the panel's declarative entries, and what they load: scripts, style sheets, images and fonts. The panel shows them in a sandboxed frame of an origin of their own, so they can never read the panel's session; the frame's address signs in what its page loads and asks for under it, as the person who opened it.",
        "operationId": "screen",
        "parameters": [
          {
            "description": "The rest of the path",
            "in": "path",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Who is asking, as JSON: type, id, name, user and source. The panel signed them in and checked they may use the add-on",
            "in": "header",
            "name": "Racksail-Actor",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The ID of the panel request this one comes from, for the add-on's logs",
            "in": "header",
            "name": "Racksail-Request-Id",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The address of the frame the panel shows the screen in, ending in a slash: the add-on's screens are at \u003cbase\u003eui/\u003cpath\u003e and its routes at \u003cbase\u003eroutes/\u003cpath\u003e, which the page's own scripts may call",
            "in": "header",
            "name": "Racksail-Frame-Base",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The nonce of the page's inline scripts, which run only with nonce=\"\u003cthis value\u003e\"; a new one comes with every request",
