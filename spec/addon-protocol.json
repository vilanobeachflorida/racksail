  "info": {
    "description": "What an add-on serves on its Unix socket for the panel: its health, its hooks, the capabilities it provides, the plans and applies of the kinds it adds, and its routes and screens. Hooks answer within their deadline; an error or a timeout counts as a failure, which blocks the change only for hooks whose failure mode is block. The panel never sends data the add-on's permissions don't grant.",
    "title": "Racksail add-on protocol",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "The panel calls it after starting the add-on and from its health checks.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddonHealth"
                }
              }
            },
            "description": "The add-on is running"
          }
        },
        "summary": "Check that the add-on is running",
        "tags": [
          "Add-on"
        ]
      }
    },
    "/hooks/{point}": {
      "post": {
        "description": "Validate hooks allow or deny one change, modify hooks return the change set with their changes, observe hooks only take note, and system hooks return the patched configuration.",
        "operationId": "runHook",
        "parameters": [
          {
            "description": "The hook point, as in the call",
            "in": "path",
            "name": "point",
            "required": true,
            "schema": {
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9_-]*)+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HookCall"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HookReply"
                }
              }
            },
            "description": "The hook's answer"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The hook failed"
          }
        },
        "summary": "Run one of the add-on's hooks",
        "tags": [
          "Add-on"
        ]
      }
    },
    "/kinds/{kind}/apply": {
      "post": {
        "description": "The panel calls it once the plan's steps have run, with what they returned. The add-on does what the plan said it would besides, and answers with the resource's status, or with a problem, which fails the change. For a resource being deleted, it undoes what it did for it.",
        "operationId": "applyKind",
        "parameters": [
          {
            "description": "The kind, one the add-on's manifest adds, such as guard.rule",
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
