{
  "components": {
    "schemas": {
      "Actor": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "impersonator": {
            "type": "string"
          },
          "impersonatorName": {
            "type": "string"
          },
          "ip": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "name",
          "source"
        ],
        "type": "object"
      },
      "AddonHealth": {
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "description": "The hook API version the add-on speaks, such as v1",
            "type": "string"
          },
          "status": {
            "description": "ok when the add-on can take hook calls",
