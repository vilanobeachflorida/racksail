          "op"
        ],
        "type": "object"
      },
      "FieldProblem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable error code",
            "type": "string"
          },
          "location": {
            "description": "Where the problem is",
            "examples": [
              "body.spec.domains[0]"
            ],
            "type": "string"
          },
          "message": {
            "description": "English explanation",
            "type": "string"
          },
          "params": {
            "additionalProperties": {},
            "type": "object"
          },
          "value": {
            "description": "The offending value, when it's safe to show"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "HealthCheck": {
        "additionalProperties": false,
        "properties": {
          "expect": {
            "description": "The expected status code, unit state, address or certificate name",
            "type": "string"
          },
          "name": {
            "description": "What the check confirms, such as the site answering",
            "type": "string"
          },
          "target": {
            "description": "A URL, host:port, unit name or DNS name",
            "type": "string"
          },
          "timeout": {
            "description": "How long the check keeps trying, in nanoseconds",
            "format": "int64",
            "type": "integer"
          },
          "type": {
            "description": "How the check works",
            "enum": [
              "http",
              "tcp",
              "unit",
              "dns",
              "tls"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "target"
        ],
        "type": "object"
      },
      "HookCall": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/Actor",
            "description": "Who is making the change, and through what"
          },
          "change": {
            "description": "Validate hooks: the index of the change to decide on",
            "format": "int64",
            "type": "integer"
          },
          "changeSet": {
            "$ref": "#/components/schemas/ChangeSet",
            "description": "The change set, at points of the change pipeline"
          },
          "changes": {
            "description": "Modify and observe hooks: the indexes of the changes the point is about",
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "config": {
            "$ref": "#/components/schemas/ConfigPatch",
            "description": "System hooks: the configuration to patch"
          },
          "data": {
            "description": "What happened, at lifecycle and identity points"
          },
          "kind": {
            "description": "What the hook may do",
            "enum": [
              "observe",
              "validate",
              "modify",
              "system"
            ],
            "type": "string"
          },
          "point": {
            "description": "The hook point, such as web.site.create.validate",
            "type": "string"
          }
        },
        "required": [
          "point",
          "kind"
        ],
        "type": "object"
      },
      "HookReply": {
        "additionalProperties": false,
        "properties": {
          "changeSet": {
            "$ref": "#/components/schemas/ChangeSet",
            "description": "Modify hooks: the change set with the hook's changes, which may be new specs for the changes the point is about, added changes and added effects. A reply that changes anything else counts as a failure of the hook"
          },
          "config": {
            "additionalProperties": {},
            "description": "System hooks: the patched configuration",
            "type": "object"
          },
          "deny": {
            "description": "Validate hooks: refuse the change",
            "type": "boolean"
          },
          "reason": {
            "description": "Why the change is refused, shown to the person making it",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable error code in the form \u003cmodule\u003e.\u003csnake_case\u003e",
            "examples": [
              "web.domain_taken"
            ],
            "type": "string"
          },
          "detail": {
            "description": "English explanation of this occurrence",
            "examples": [
              "The domain example.com is already used by another site."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Problems with individual fields",
            "items": {
              "$ref": "#/components/schemas/FieldProblem"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference for this occurrence",
            "format": "uri",
            "type": "string"
          },
          "params": {
            "additionalProperties": {},
            "description": "Values for the placeholders in the code's message",
            "type": "object"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              409
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Short summary of the problem type",
            "examples": [
              "Conflict"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference for the problem type",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "ProvideCall": {
        "additionalProperties": false,
        "properties": {
          "input": {
            "description": "What the method takes, as the capability's interface describes it"
          }
        },
        "type": "object"
      },
      "ResourceChange": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "after": {},
          "before": {},
          "checks": {
            "items": {
              "$ref": "#/components/schemas/HealthCheck"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "diff": {
            "items": {
              "$ref": "#/components/schemas/FieldDiff"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "input": {},
          "kind": {
            "type": "string"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "labelsBefore": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "op": {
            "enum": [
              "create",
              "update",
              "delete",
              "action"
            ],
            "type": "string"
          },
          "output": {
            "description": "What the action returned, once it was applied"
          },
          "revision": {
            "format": "int64",
            "type": "integer"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "server": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "state": {
            "description": "How far carrying out the change got: started while it runs or after it failed, done once it is in place; empty until it starts",
            "enum": [
              "started",
              "done"
            ],
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "op",
          "kind",
          "id",
          "scope",
          "source"
        ],
        "type": "object"
      },
      "Scope": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "The owning reseller or account; empty for server-wide resources",
            "type": "string"
          },
          "level": {
            "description": "Who owns the resource",
            "enum": [
              "server",
              "reseller",
              "account"
            ],
            "type": "string"
          }
        },
        "required": [
          "level"
        ],
        "type": "object"
      },
      "Snapshot": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Where the snapshot is",
            "type": "string"
          },
          "source": {
            "description": "The subvolume, such as /srv/racksail",
            "type": "string"
          }
        },
        "required": [
          "source",
          "path"
        ],
        "type": "object"
      },
      "Source": {
        "additionalProperties": false,
        "properties": {
          "hook": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "request",
              "hook",
              "rule",
              "addon",
              "module"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "Step": {
        "additionalProperties": false,
        "properties": {
          "input": {
            "description": "The operation's input"
          },
          "op": {
            "description": "Operation name",
            "type": "string"
          },
          "title": {
            "description": "What the step does, for progress logs",
            "type": "string"
          }
        },
        "required": [
          "op",
          "input"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "What an add-on serves on its Unix socket for the panel: its health, and its hooks. Hooks answer within their deadline; an error or a timeout counts as a failure, which blocks the change only for hooks whose failure mode is block. The panel never sends data the add-on's permissions don't grant.",
    "title": "Racksail add-on protocol",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "The panel calls it after starting the add-on and from its health checks.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddonHealth"
                }
              }
            },
            "description": "The add-on is running"
          }
        },
        "summary": "Check that the add-on is running",
        "tags": [
          "Add-on"
        ]
      }
    },
    "/hooks/{point}": {
      "post": {
        "description": "Validate hooks allow or deny one change, modify hooks return the change set with their changes, observe hooks only take note, and system hooks return the patched configuration.",
        "operationId": "runHook",
        "parameters": [
          {
            "description": "The hook point, as in the call",
            "in": "path",
            "name": "point",
            "required": true,
            "schema": {
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9_-]*)+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HookCall"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HookReply"
                }
              }
            },
            "description": "The hook's answer"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The hook failed"
          }
        },
        "summary": "Run one of the add-on's hooks",
        "tags": [
          "Add-on"
        ]
      }
    },
    "/provide/{capability}/{method}": {
      "post": {
        "description": "The panel calls it when it uses a capability the add-on declares under provides, such as sending a notification for notifier or creating a record for dns. The capability's interface says what each method takes and returns.",
        "operationId": "provide",
        "parameters": [
          {
            "description": "The capability, as under provides",
            "in": "path",
            "name": "capability",
            "required": true,
            "schema": {
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            }
          },
          {
            "description": "The method, such as send",
            "in": "path",
            "name": "method",
            "required": true,
            "schema": {
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvideCall"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "What the method returns"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The hook failed"
          }
        },
        "summary": "Call a method of a capability the add-on provides",
        "tags": [
          "Add-on"
        ]
      }
    },
    "/routes/{path}": {
      "delete": {
        "description": "The panel passes requests for /api/v1/addons/\u003cid\u003e/\u003cpath\u003e on to the add-on, for the routes its manifest declares. Cookies and credentials stay with the panel; the add-on learns who asks from Racksail-Actor.",
        "operationId": "routeDelete",
        "parameters": [
          {
            "description": "The rest of the path",
            "in": "path",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Who is asking, as JSON: type, id, name, user and source. The panel signed them in and checked they may use the add-on",
            "in": "header",
            "name": "Racksail-Actor",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The ID of the panel request this one comes from, for the add-on's logs",
            "in": "header",
            "name": "Racksail-Request-Id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Whatever the route answers"
          }
        },
        "summary": "Serve one of the add-on's API routes",
        "tags": [
          "Add-on"
        ]
      },
      "get": {
        "description": "The panel passes requests for /api/v1/addons/\u003cid\u003e/\u003cpath\u003e on to the add-on, for the routes its manifest declares. Cookies and credentials stay with the panel; the add-on learns who asks from Racksail-Actor.",
        "operationId": "routeGet",
        "parameters": [
          {
            "description": "The rest of the path",
            "in": "path",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Who is asking, as JSON: type, id, name, user and source. The panel signed them in and checked they may use the add-on",
            "in": "header",
            "name": "Racksail-Actor",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The ID of the panel request this one comes from, for the add-on's logs",
            "in": "header",
            "name": "Racksail-Request-Id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Whatever the route answers"
          }
        },
        "summary": "Serve one of the add-on's API routes",
        "tags": [
          "Add-on"
        ]
      },
      "patch": {
        "description": "The panel passes requests for /api/v1/addons/\u003cid\u003e/\u003cpath\u003e on to the add-on, for the routes its manifest declares. Cookies and credentials stay with the panel; the add-on learns who asks from Racksail-Actor.",
        "operationId": "routePatch",
        "parameters": [
          {
            "description": "The rest of the path",
            "in": "path",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
