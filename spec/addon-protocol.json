            },
            "type": [
              "array",
              "null"
            ]
          },
          "state": {
            "enum": [
              "planned",
              "applying",
              "applied",
              "failed",
              "undone"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "undoOf": {
            "type": "string"
          }
        },
        "required": [
