            },
            "type": [
              "array",
              "null"
            ]
          },
          "effects": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "summary": {
