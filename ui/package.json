{
  "name": "@racksail/ui",
  "private": true,
  "version": "0.0.0",
  "description": "The Racksail web UI.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "lint": "biome check . && node scripts/check-tokens.mjs",
    "format": "biome format --write .",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../spec/openapi.json --output src/lib/api/schema.d.ts",
    "check:api": "openapi-typescript ../spec/openapi.json --output src/lib/api/schema.d.ts --check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
