### scripts/postinst -rwxr-xr-x
#!/bin/sh
# Generated by packaging/deb from the plan of racksail install --convert.
set -e

if [ "$1" = configure ]; then
	systemd-sysusers racksail.conf
	systemd-tmpfiles --create racksail.conf
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
	fi
	if [ -z "$2" ]; then
		deb-systemd-helper enable racksail-agent.service racksail-panel.service racksail-edge.socket >/dev/null || true
		if [ -d /run/systemd/system ]; then
			deb-systemd-invoke start racksail-agent.service racksail-panel.service racksail-edge.socket >/dev/null || true
		fi
	elif [ -d /run/systemd/system ]; then
		deb-systemd-invoke try-restart racksail-agent.service racksail-panel.service racksail-edge.service >/dev/null || true
	fi
fi

### scripts/postrm -rwxr-xr-x
#!/bin/sh
# Generated by packaging/deb from the plan of racksail install --convert.
# Purging keeps /var/lib/racksail and /srv/racksail, which hold the panel's
# state and the accounts' data.
set -e

if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
	systemctl --system daemon-reload >/dev/null || true
fi
if [ "$1" = remove ] && [ -x /usr/bin/deb-systemd-helper ]; then
	deb-systemd-helper mask racksail-agent.service racksail-panel.service racksail-edge.socket racksail-edge.service >/dev/null || true
fi
if [ "$1" = purge ] && [ -x /usr/bin/deb-systemd-helper ]; then
	deb-systemd-helper purge racksail-agent.service racksail-panel.service racksail-edge.socket racksail-edge.service >/dev/null || true
	deb-systemd-helper unmask racksail-agent.service racksail-panel.service racksail-edge.socket racksail-edge.service >/dev/null || true
fi

### scripts/prerm -rwxr-xr-x
#!/bin/sh
# Generated by packaging/deb from the plan of racksail install --convert.
set -e

if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
	deb-systemd-invoke stop racksail-edge.service racksail-edge.socket racksail-panel.service racksail-agent.service >/dev/null || true
fi

### sysusers/racksail.conf -rw-r--r--
# Generated by packaging/deb from the plan of racksail install --convert.
u racksail - "Racksail panel" /var/lib/racksail -
u racksail-edge - "Racksail edge" /nonexistent -

### tmpfiles/racksail.conf -rw-r--r--
# Generated by packaging/deb from the plan of racksail install --convert.
d /etc/racksail 0755 root root -
d /etc/racksail/generated 0755 root root -
d /etc/racksail/certs 0755 root root -
d /var/lib/racksail 0750 racksail racksail -
d /srv/racksail 0755 root root -
d /srv/racksail/accounts 0755 root root -
d /opt/racksail 0755 root root -
d /opt/racksail/runtimes 0755 root root -
d /opt/racksail/modules 0755 root root -
d /var/log/racksail 0750 root root -
d /mnt/racksail 0755 root root -

### units/racksail-accounts.slice -rw-r--r--
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail accounts
Before=slices.target

[Slice]

### units/racksail-agent.service -rw-r--r--
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail agent
Documentation=https://github.com/vilanobeachflorida/racksail
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/racksail agent
Slice=racksail.slice
Restart=on-failure
RestartSec=2s
RuntimeDirectory=racksail
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target

### units/racksail-edge.service -rw-r--r--
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail edge
Documentation=https://github.com/vilanobeachflorida/racksail
Requires=racksail-edge.socket
After=network-online.target racksail-edge.socket
Wants=network-online.target

[Service]
ExecStart=/usr/bin/racksail edge
User=racksail-edge
Group=racksail-edge
Slice=racksail.slice
Restart=on-failure
RestartSec=2s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=racksail-edge
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
Also=racksail-edge.socket

### units/racksail-edge.socket -rw-r--r--
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail edge admin socket
Documentation=https://github.com/vilanobeachflorida/racksail

[Socket]
ListenStream=/run/racksail/edge.sock
SocketUser=root
SocketGroup=racksail
SocketMode=0660

[Install]
WantedBy=sockets.target

### units/racksail-panel.service -rw-r--r--
