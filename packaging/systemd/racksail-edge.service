# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail edge
Documentation=https://github.com/vilanobeachflorida/racksail
Requires=racksail-edge.socket
After=network-online.target racksail-edge.socket
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/racksail edge
User=racksail-edge
Group=racksail-edge
Slice=racksail.slice
Restart=on-failure
RestartSec=2s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=racksail-edge
StateDirectoryMode=0750
LimitNOFILE=1048576
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
UMask=0027
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
Also=racksail-edge.socket
