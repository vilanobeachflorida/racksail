# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail panel
Documentation=https://github.com/vilanobeachflorida/racksail
After=network-online.target racksail-agent.service
Wants=network-online.target racksail-agent.service

[Service]
Type=exec
ExecStart=/usr/bin/racksail panel
User=racksail
Group=racksail
Slice=racksail.slice
Restart=on-failure
RestartSec=2s
StateDirectory=racksail
StateDirectoryMode=0750
CacheDirectory=racksail
CacheDirectoryMode=0750
ReadWritePaths=/var/lib/racksail
ImportCredential=racksail-secrets-key
CapabilityBoundingSet=
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
UMask=0027
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
