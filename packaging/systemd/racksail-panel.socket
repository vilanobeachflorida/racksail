# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail panel edge socket
Documentation=https://github.com/vilanobeachflorida/racksail

[Socket]
ListenStream=/run/racksail/panel.sock
SocketUser=root
SocketGroup=racksail-edge
SocketMode=0660

[Install]
WantedBy=sockets.target
