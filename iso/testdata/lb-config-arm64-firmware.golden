config
noauto
--mode
debian
--distribution
trixie
--architecture
arm64
--archive-areas
main non-free-firmware
--firmware-chroot
true
--firmware-binary
false
--binary-image
iso-hybrid
--bootloaders
grub-efi
--uefi-secure-boot
enable
--linux-packages
linux-image
--debian-installer
none
--memtest
none
--initramfs
live-boot
--initsystem
systemd
--apt-recommends
false
--apt-indices
false
--apt-source-archives
false
--security
true
--updates
true
--backports
false
--mirror-bootstrap
http://deb.debian.org/debian/
--mirror-chroot
http://deb.debian.org/debian/
--mirror-binary
http://deb.debian.org/debian/
--mirror-chroot-security
http://deb.debian.org/debian-security/
--mirror-binary-security
http://deb.debian.org/debian-security/
--bootappend-live
boot=live
--bootappend-live-failsafe
none
--chroot-squashfs-compression-type
xz
--checksums
sha256
--image-name
racksail
--iso-application
Racksail installer
--iso-publisher
Racksail
--iso-preparer
live-build
--iso-volume
RACKSAIL_ARM64_FIRMWARE
--zsync
false
--debug
