# Racksail's boot splash: the mark on navy, a progress bar under it, and
# messages and password prompts under that, in the brand's light text.

Window.SetBackgroundTopColor(0.004, 0.129, 0.310);
Window.SetBackgroundBottomColor(0.000, 0.090, 0.220);

screen.x = Window.GetX();
screen.y = Window.GetY();
screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen.x + screen.w / 2 - logo.image.GetWidth() / 2;
logo.y = screen.y + screen.h / 2 - logo.image.GetHeight() / 2 - 60;
logo.sprite.SetPosition(logo.x, logo.y, 0);

track.image = Image("progress-track.png");
track.sprite = Sprite(track.image);
track.x = screen.x + screen.w / 2 - track.image.GetWidth() / 2;
track.y = logo.y + logo.image.GetHeight() + 56;
track.sprite.SetPosition(track.x, track.y, 1);

bar.image = Image("progress-bar.png");
bar.sprite = Sprite();
bar.sprite.SetPosition(track.x, track.y, 2);

fun progress_callback(duration, progress) {
	width = Math.Int(bar.image.GetWidth() * progress);
	if (width < 1)
		width = 1;
	bar.sprite.SetImage(bar.image.Scale(width, bar.image.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

message.sprite = Sprite();
fun message_callback(text) {
	message.image = Image.Text(text, 0.902, 0.929, 0.961);
	message.sprite.SetImage(message.image);
	message.sprite.SetPosition(screen.x + screen.w / 2 - message.image.GetWidth() / 2, track.y + 32, 3);
}
Plymouth.SetMessageFunction(message_callback);

prompt.sprite = Sprite();
entry.sprite = Sprite();
fun display_password_callback(text, bullets) {
	prompt.image = Image.Text(text, 0.902, 0.929, 0.961);
	prompt.sprite.SetImage(prompt.image);
	prompt.sprite.SetPosition(screen.x + screen.w / 2 - prompt.image.GetWidth() / 2, track.y + 64, 3);
	shown = "";
	i = 0;
	while (i < bullets) {
		shown = shown + "*";
		i = i + 1;
	}
	entry.image = Image.Text(shown, 0.239, 0.608, 1.0);
	entry.sprite.SetImage(entry.image);
	entry.sprite.SetPosition(screen.x + screen.w / 2 - entry.image.GetWidth() / 2, track.y + 92, 3);
	prompt.sprite.SetOpacity(1);
	entry.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
	prompt.sprite.SetOpacity(0);
	entry.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun quit_callback() {
	bar.sprite.SetImage(bar.image);
}
Plymouth.SetQuitFunction(quit_callback);
