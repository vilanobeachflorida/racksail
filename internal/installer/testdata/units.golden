### racksail.slice
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail platform services
Before=slices.target

[Slice]

### racksail-accounts.slice
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail accounts
Before=slices.target

[Slice]

### racksail-agent.service
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail agent
Documentation=https://github.com/vilanobeachflorida/racksail
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/racksail agent
Slice=racksail.slice
Restart=on-failure
RestartSec=2s
RuntimeDirectory=racksail
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target

### racksail-panel.service
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail panel
Documentation=https://github.com/vilanobeachflorida/racksail
After=network-online.target racksail-agent.service
Wants=network-online.target racksail-agent.service

[Service]
ExecStart=/usr/local/bin/racksail panel
User=racksail
Group=racksail
Slice=racksail.slice
Restart=on-failure
RestartSec=2s
StateDirectory=racksail
StateDirectoryMode=0750
ReadWritePaths=/var/lib/racksail
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target

### racksail-edge.socket
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail edge admin socket
Documentation=https://github.com/vilanobeachflorida/racksail

[Socket]
ListenStream=/run/racksail/edge.sock
SocketUser=root
SocketGroup=racksail
SocketMode=0660

[Install]
WantedBy=sockets.target

### racksail-edge.service
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail edge
Documentation=https://github.com/vilanobeachflorida/racksail
Requires=racksail-edge.socket
After=network-online.target racksail-edge.socket
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/racksail edge
User=racksail-edge
Group=racksail-edge
Slice=racksail.slice
Restart=on-failure
RestartSec=2s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=racksail-edge
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
Also=racksail-edge.socket

