### racksail-accounts.slice
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail accounts
Documentation=https://github.com/vilanobeachflorida/racksail
Before=slices.target

[Slice]
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
TasksAccounting=yes
CPUWeight=100
IOWeight=100

### racksail-agent.service
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail agent
Documentation=https://github.com/vilanobeachflorida/racksail
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/racksail agent
Slice=racksail.slice
Restart=on-failure
RestartSec=2s
RuntimeDirectory=racksail
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=racksail-agent
StateDirectoryMode=0700
LimitNOFILE=65536
RestrictRealtime=yes
LockPersonality=yes
KeyringMode=private
UMask=0022

[Install]
WantedBy=multi-user.target

### racksail-edge.service
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail edge
Documentation=https://github.com/vilanobeachflorida/racksail
Requires=racksail-edge.socket
After=network-online.target racksail-edge.socket
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/racksail edge
User=racksail-edge
Group=racksail-edge
Slice=racksail.slice
Restart=on-failure
RestartSec=2s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=racksail-edge
StateDirectoryMode=0750
Environment=XDG_DATA_HOME=/var/lib/racksail-edge
LimitNOFILE=1048576
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
UMask=0027
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
Also=racksail-edge.socket

### racksail-edge.socket
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail edge admin socket
Documentation=https://github.com/vilanobeachflorida/racksail

[Socket]
ListenStream=/run/racksail/edge.sock
SocketUser=root
SocketGroup=racksail
SocketMode=0660

[Install]
WantedBy=sockets.target

### racksail-panel.service
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail panel
Documentation=https://github.com/vilanobeachflorida/racksail
After=network-online.target racksail-agent.service
Wants=network-online.target racksail-agent.service

[Service]
Type=exec
ExecStart=/usr/bin/racksail panel
User=racksail
Group=racksail
Slice=racksail.slice
Restart=on-failure
RestartSec=2s
StateDirectory=racksail
StateDirectoryMode=0750
CacheDirectory=racksail
CacheDirectoryMode=0750
ReadWritePaths=/var/lib/racksail
ImportCredential=racksail-secrets-key
CapabilityBoundingSet=
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
UMask=0027
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

### racksail.slice
# Managed by Racksail. Changes made here are overwritten.

[Unit]
Description=Racksail platform services
Documentation=https://github.com/vilanobeachflorida/racksail
Before=slices.target

[Slice]
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
TasksAccounting=yes
CPUWeight=500
IOWeight=500
MemoryLow=128M

