# Managed by Racksail. Changes made here are overwritten.
table inet racksail {
	set allow_v4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 192.0.2.10 }
	}
	set allow_v6 {
		type ipv6_addr
		flags interval
		auto-merge
		elements = { 2001:db8:ffff::/48 }
	}
	set deny_v4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 203.0.113.0/25 }
	}
	set deny_v6 {
		type ipv6_addr
		flags interval
		auto-merge
	}
	set ban_ssh_v4 {
		type ipv4_addr
		flags timeout
		timeout 3600s
	}
	set ban_ssh_v6 {
		type ipv6_addr
		flags timeout
		timeout 3600s
	}
	set ban_panel_v4 {
		type ipv4_addr
		flags timeout
		timeout 1800s
	}
	set ban_panel_v6 {
		type ipv6_addr
		flags timeout
		timeout 1800s
	}
	set block_countries_v4 {
		type ipv4_addr
		flags interval
		auto-merge
	}
	set block_countries_v6 {
		type ipv6_addr
		flags interval
		auto-merge
	}
	set rate_tcp_22_v4 {
		type ipv4_addr
		size 65535
		flags dynamic,timeout
		timeout 1h
	}
	set rate_tcp_22_v6 {
		type ipv6_addr
		size 65535
		flags dynamic,timeout
		timeout 1h
	}
	chain input {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		ct state vmap { established : accept, related : accept, invalid : drop }
		ip saddr @deny_v4 drop
		ip6 saddr @deny_v6 drop
		ip saddr @allow_v4 accept
		ip6 saddr @allow_v6 accept
		ip saddr @ban_ssh_v4 drop
		ip6 saddr @ban_ssh_v6 drop
		ip saddr @ban_panel_v4 drop
		ip6 saddr @ban_panel_v6 drop
		ip saddr @block_countries_v4 drop
		ip6 saddr @block_countries_v6 drop
		ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		ip protocol icmp icmp type echo-request limit rate 20/second burst 50 packets accept
		meta l4proto ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-query, mld2-listener-report } accept
		meta l4proto ipv6-icmp icmpv6 type echo-request limit rate 20/second burst 50 packets accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
		meta nfproto ipv4 tcp dport 22 ct state new add @rate_tcp_22_v4 { ip saddr limit rate over 10/minute burst 20 packets } drop
		meta nfproto ipv6 tcp dport 22 ct state new add @rate_tcp_22_v6 { ip6 saddr limit rate over 10/minute burst 20 packets } drop
		tcp dport 22 accept comment "SSH"
		tcp dport { 80, 443 } accept comment "Web"
		udp dport 443 accept comment "HTTP/3"
		ip saddr { 198.51.100.0/24, 192.0.2.7 } tcp dport 8443 accept comment "Panel"
		ip6 saddr { 2001:db8:1::/48 } tcp dport 8443 accept comment "Panel"
		udp dport 60000-61000 accept comment "Mosh"
		limit rate 5/minute burst 10 packets log prefix "racksail drop: " level info
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state vmap { established : accept, related : accept, invalid : drop }
		iifname "br0" oifname "enp1s0" accept
		iifname "enp1s0" oifname "br0" accept
	}
	chain output {
		type filter hook output priority filter; policy accept;
	}
	chain mark_accounts {
		type route hook output priority mangle; policy accept;
		meta skuid 20001 meta mark set 0x00004e21
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		meta nfproto ipv4 meta mark 0x00004e21 snat ip to 203.0.113.11
		meta nfproto ipv6 meta mark 0x00004e21 snat ip6 to 2001:db8::11
		ip saddr 10.10.0.0/24 oifname "enp1s0" masquerade
	}
}
